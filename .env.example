# Docker Compose
COMPOSE_PROJECT_NAME=payments
APP_BUILD_CONTEXT=.
APP_SOURCE_PATH=.
APP_BIND_HOST=0.0.0.0
APP_HOST_PORT=8765
APP_CONTAINER_PORT=8000
WORKER_RESTART_POLICY=unless-stopped

# Django
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=payments
POSTGRES_USER=payments
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_VOLUME_NAME=payments_postgres_data
POSTGRES_HEALTHCHECK_INTERVAL=5s
POSTGRES_HEALTHCHECK_TIMEOUT=5s
POSTGRES_HEALTHCHECK_RETRIES=10
